---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { apps } from '../data/apps';
---

<SiteLayout title="Apps" description="Open-source projects and apps">
	<SiteHeader />
	<main>
		<section class="apps">
			<div class="container">
				<h1>Apps</h1>
				<p class="desc">These are all of my open-source projects I've worked on or I'm currently working on.</p>
				<div class="apps-container">
					{apps.map(app => (
						<a class="app" href={app.external_url} target="_blank" rel="noreferrer">
							<img class="app-image" src={app.image} alt={`${app.title} icon`} width="128" height="128" />
						</a>
					))}
				</div>
			</div>
		</section>
	</main>
</SiteLayout>

<style>
.container { max-width: 900px; margin: 0 auto; padding: 2rem 1rem; }
.desc { color: #6b7280; margin-top: .5rem; }
.apps-container { display: flex; flex-direction: row; flex-wrap: wrap; justify-content: start; align-items: flex-start; gap: 20px; margin-top: 2rem; }
.app { display: flex; flex-direction: row; text-decoration: none; box-shadow: none; transition: scale .5s ease-in-out; }
.app:hover { transition: scale .5s ease-in-out; scale: 110%; }
.app-image { display: flex; border-radius: 20px; }
</style>

