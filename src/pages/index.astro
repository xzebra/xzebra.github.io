---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Jorge Romanos" description="Software developer">
	<main class="page">
		<header data-anim>
			<h1>Jorge Romanos</h1>
			<span class="tagline"><svg class="loc-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>Spain <span class="dot">&middot;</span> @zebra</span>
		</header>

		<div class="bio">
			<p data-anim>
				Software Engineer with a special interest in the Apple ecosystem. Cybersecurity enthusiast. Currently working at <a href="https://whop.com" class="whop-link" data-text="Whop"><img src="/images/whop.png" alt="Whop" class="inline-icon" width="14" height="14" /> Whop</a> as an iOS Engineer.
			</p>

			<p data-anim>
				I started learning to code at a young age by modding videogames, then took it more seriously with competitive programming and made it to the national final. I studied Software Engineering at the <a href="https://eina.unizar.es/en/welcome" data-text="University of Zaragoza">University of Zaragoza</a>. I love automating stuff and in my free time I build apps and tools.
			</p>

			<p class="socials-line" data-anim>
				You can find me on
				<span class="app-icons">
					<a href="https://x.com/zebra_dev" target="_blank" rel="noreferrer" aria-label="X" class="app-icon">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="#fff" xmlns="http://www.w3.org/2000/svg"><rect width="24" height="24" rx="5.4" fill="#000"/><path d="M13.52 10.63 18.2 5.2h-1.1l-4.07 4.71L9.55 5.2H5.2l4.91 7.13L5.2 18h1.11l4.3-4.97L14.45 18h4.35l-5.09-7.37h-.19Zm-1.52 1.76-.5-.71L6.8 6.06h1.71l3.2 4.57.5.71 4.17 5.95h-1.71l-3.17-4.9Z" fill="#fff"/></svg>
					</a>
					<a href="https://instagram.com/zebra_dev" target="_blank" rel="noreferrer" aria-label="Instagram" class="app-icon">
						<svg width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><defs><radialGradient id="ig1" cx="30%" cy="107%" r="150%"><stop offset="0%" stop-color="#fdf497"/><stop offset="5%" stop-color="#fdf497"/><stop offset="45%" stop-color="#fd5949"/><stop offset="60%" stop-color="#d6249f"/><stop offset="90%" stop-color="#285AEB"/></radialGradient></defs><rect width="24" height="24" rx="5.4" fill="url(#ig1)"/><rect x="4.5" y="4.5" width="15" height="15" rx="4" stroke="#fff" stroke-width="1.5" fill="none"/><circle cx="12" cy="12" r="3.5" stroke="#fff" stroke-width="1.5" fill="none"/><circle cx="17" cy="7" r="1" fill="#fff"/></svg>
					</a>
					<a href="https://github.com/xzebra" target="_blank" rel="noreferrer" aria-label="GitHub" class="app-icon">
						<svg width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><rect width="24" height="24" rx="5.4" fill="#24292f"/><path d="M12 3.5a8.5 8.5 0 0 0-2.69 16.56c.43.08.58-.18.58-.41v-1.44c-2.37.52-2.87-1.14-2.87-1.14a2.26 2.26 0 0 0-.95-1.25c-.77-.53.06-.52.06-.52a1.8 1.8 0 0 1 1.31.88 1.82 1.82 0 0 0 2.49.71 1.82 1.82 0 0 1 .54-1.14c-1.89-.21-3.88-.95-3.88-4.22a3.31 3.31 0 0 1 .88-2.3 3.08 3.08 0 0 1 .08-2.26s.72-.23 2.35.88a8.1 8.1 0 0 1 4.27 0c1.63-1.1 2.35-.88 2.35-.88a3.08 3.08 0 0 1 .08 2.27 3.31 3.31 0 0 1 .88 2.29c0 3.28-2 4-3.9 4.21a2.04 2.04 0 0 1 .58 1.58v2.35c0 .23.15.49.59.41A8.5 8.5 0 0 0 12 3.5Z" fill="#fff"/></svg>
					</a>
					<a href="mailto:contact@xzebra.dev" aria-label="Email" class="app-icon">
						<svg width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="ml1" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#6dd0f5"/><stop offset="100%" stop-color="#1a8feb"/></linearGradient></defs><rect width="24" height="24" rx="5.4" fill="url(#ml1)"/><path d="M5 8.5l7 4.5 7-4.5" stroke="#fff" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/><rect x="5" y="7" width="14" height="10" rx="1.5" stroke="#fff" stroke-width="1.3" fill="none"/></svg>
					</a>
				</span>
			</p>
		</div>

		<section class="projects">
			<h2 data-anim>Projects</h2>
			<ul>
				<li data-anim>
					<a href="https://autoglot.app"><img src="/images/projects/Autoglot.svg" alt="" class="project-icon" width="18" height="18" /> Autoglot</a>
					<span class="desc">AI-powered translation for your apps</span>
				</li>
				<li data-anim>
					<a href="https://appframes.app"><img src="/images/projects/AppFrames.png" alt="" class="project-icon" width="18" height="18" /> AppFrames</a>
					<span class="desc">Device frame screenshots for the App Store</span>
				</li>
				<li data-anim>
					<a href="https://billsharing.app"><img src="/images/projects/BillShare.png" alt="" class="project-icon" width="18" height="18" /> BillShare</a>
					<span class="desc">Split bills with friends</span>
				</li>
				<li data-anim>
					<a href="https://blocko.app"><img src="/images/projects/Blocko.png" alt="" class="project-icon" width="18" height="18" /> Blocko</a>
					<span class="desc">Infinite puzzles to train your brain</span>
				</li>
				<li data-anim>
					<a href="https://visitplaces.app"><img src="/images/projects/Places.jpg" alt="" class="project-icon" width="18" height="18" /> Places</a>
					<span class="desc">Save and share places you visit</span>
				</li>
				<li data-anim>
					<a href="https://timedeposit.app"><img src="/images/projects/TimeDeposit.png" alt="" class="project-icon" width="18" height="18" /> TimeDeposit</a>
					<span class="desc">Track your time deposits</span>
				</li>
				<li class="teaser" data-anim>
					<span class="teaser-text">Always building something new...</span>
					<div class="ghchart-wrap">
						<div class="ghchart" id="ghchart"></div>
					</div>
				</li>
			</ul>
		</section>
	</main>
</SiteLayout>

<script>
	const stack = document.querySelector('.app-icons');
	const icons = Array.from(stack.querySelectorAll('.app-icon'));
	const COLLAPSED_OFFSET = -5;
	const EXPANDED_GAP = 4;
	const STIFFNESS = 0.15;
	const DAMPING = 0.7;

	let expanded = false;
	let springs = icons.map((_, i) => ({
		current: i === 0 ? 0 : COLLAPSED_OFFSET,
		target: i === 0 ? 0 : COLLAPSED_OFFSET,
		velocity: 0,
		scale: 1,
		scaleTarget: 1,
		scaleVelocity: 0,
	}));

	let raf = null;

	function animate() {
		let settled = true;
		icons.forEach((icon, i) => {
			const s = springs[i];

			// position spring
			const force = (s.target - s.current) * STIFFNESS;
			s.velocity = (s.velocity + force) * DAMPING;
			s.current += s.velocity;

			// scale spring
			const scaleForce = (s.scaleTarget - s.scale) * STIFFNESS;
			s.scaleVelocity = (s.scaleVelocity + scaleForce) * DAMPING;
			s.scale += s.scaleVelocity;

			if (Math.abs(s.velocity) > 0.01 || Math.abs(s.target - s.current) > 0.01 ||
				Math.abs(s.scaleVelocity) > 0.001 || Math.abs(s.scaleTarget - s.scale) > 0.001) {
				settled = false;
			}

			icon.style.transform = `translateX(${i === 0 ? 0 : s.current * i}px) scale(${s.scale})`;
			icon.style.zIndex = s.scale > 1.05 ? '2' : '';
		});

		if (!settled) {
			raf = requestAnimationFrame(animate);
		} else {
			raf = null;
		}
	}

	function startAnim() {
		if (!raf) raf = requestAnimationFrame(animate);
	}

	stack.addEventListener('mouseenter', () => {
		expanded = true;
		springs.forEach((s, i) => {
			s.target = i === 0 ? 0 : EXPANDED_GAP;
		});
		startAnim();
	});

	stack.addEventListener('mouseleave', () => {
		expanded = false;
		springs.forEach((s, i) => {
			s.target = i === 0 ? 0 : COLLAPSED_OFFSET;
			s.scaleTarget = 1;
		});
		startAnim();
	});

	icons.forEach((icon, i) => {
		icon.addEventListener('mouseenter', () => {
			springs[i].scaleTarget = 1.2;
			startAnim();
		});
		icon.addEventListener('mouseleave', () => {
			springs[i].scaleTarget = 1;
			startAnim();
		});
	});

	// Set initial positions
	icons.forEach((icon, i) => {
		icon.style.transform = `translateX(${i === 0 ? 0 : COLLAPSED_OFFSET * i}px) scale(1)`;
	});

	// Mobile: tap to expand, tap icon to open link
	let touchExpanded = false;
	stack.addEventListener('touchstart', (e) => {
		if (!touchExpanded) {
			e.preventDefault();
			touchExpanded = true;
			stack.classList.add('touched');
			springs.forEach((s, i) => {
				s.target = i === 0 ? 0 : EXPANDED_GAP;
			});
			startAnim();
		}
	}, { passive: false });

	// Collapse on tap outside
	document.addEventListener('touchstart', (e) => {
		if (touchExpanded && !stack.contains(e.target)) {
			touchExpanded = false;
			stack.classList.remove('touched');
			springs.forEach((s, i) => {
				s.target = i === 0 ? 0 : COLLAPSED_OFFSET;
				s.scaleTarget = 1;
			});
			startAnim();
		}
	});

	// Make project rows clickable
	document.querySelectorAll('.projects li:not(.teaser)').forEach(li => {
		li.addEventListener('click', () => {
			const link = li.querySelector('a');
			if (link) window.open(link.href, '_blank');
		});
	});

	// GitHub contribution chart
	const COLORS = ['#ebedf0', '#9be9a8', '#40c463', '#30a14e', '#216e39'];
	const chart = document.getElementById('ghchart');
	const teaser = document.querySelector('.teaser');
	let allCells = [];

	function buildChart(weeks) {
		chart.innerHTML = '';
		allCells = [];
		weeks.forEach((week, wi) => {
			const col = document.createElement('div');
			col.className = 'ghchart-col';
			week.forEach((day, di) => {
				const cell = document.createElement('div');
				cell.className = 'ghchart-cell';
				cell.style.background = COLORS[day.level] || COLORS[0];
				cell.style.transform = 'scale(0)';
				const color = COLORS[day.level] || COLORS[0];
				cell.dataset.color = color;
				cell.style.filter = 'grayscale(100%)';
				col.appendChild(cell);
				allCells.push({ el: cell, col: wi, row: di });
			});
			chart.appendChild(col);
		});
	}

	// Radial hover effect
	const RADIUS = 4;
	chart.addEventListener('mousemove', (e) => {
		const rect = chart.getBoundingClientRect();
		const cols = chart.children;
		if (!cols.length) return;
		const colWidth = rect.width / cols.length;
		const rowHeight = rect.height / 7;
		const mouseCol = (e.clientX - rect.left) / colWidth;
		const mouseRow = (e.clientY - rect.top) / rowHeight;

		allCells.forEach(({ el, col, row }) => {
			const dx = col - mouseCol;
			const dy = row - mouseRow;
			const dist = Math.sqrt(dx * dx + dy * dy);
			if (dist < RADIUS) {
				const t = 1 - dist / RADIUS;
				const scale = 1 + t * 0.4;
				el.style.transform = `scale(${scale})`;
				el.style.filter = 'grayscale(0%)';
			} else {
				el.style.transform = 'scale(1)';
				el.style.filter = 'grayscale(100%)';
			}
		});
	});

	chart.addEventListener('mouseleave', () => {
		allCells.forEach(({ el }) => {
			el.style.transform = 'scale(1)';
			el.style.filter = 'grayscale(100%)';
		});
	});

	let pendingTimers = [];

	function animateCells(show) {
		// Cancel all pending animations
		pendingTimers.forEach(id => clearTimeout(id));
		pendingTimers = [];

		// Immediately set all cells to target if hiding (clean slate)
		if (!show) {
			allCells.forEach(({ el }) => {
				el.style.transition = 'none';
				el.style.transform = 'scale(0)';
			});
			return;
		}

		// When showing, first reset all to 0 instantly, then animate in
		allCells.forEach(({ el }) => {
			el.style.transition = 'none';
			el.style.transform = 'scale(0)';
		});

		// Force reflow
		chart.offsetHeight;

		const maxCol = allCells.length > 0 ? allCells[allCells.length - 1].col : 0;
		allCells.forEach(({ el, col }) => {
			const delay = col * 15;
			const id = setTimeout(() => {
				el.style.transition = 'transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1)';
				el.style.transform = 'scale(1)';
			}, delay);
			pendingTimers.push(id);
		});

		// Clear transitions after reveal completes so hover is instant
		const totalDuration = allCells.length > 0 ? allCells[allCells.length - 1].col * 15 + 400 : 500;
		const clearId = setTimeout(() => {
			allCells.forEach(({ el }) => {
				el.style.transition = 'none';
			});
		}, totalDuration);
		pendingTimers.push(clearId);
	}

	chart.style.cursor = 'pointer';
	chart.addEventListener('click', () => window.open('https://github.com/xzebra', '_blank'));

	let chartRevealed = false;
	teaser.addEventListener('mouseenter', () => {
		if (!chartRevealed) {
			chartRevealed = true;
			document.querySelector('.ghchart-wrap').style.maxHeight = '120px';
			document.querySelector('.ghchart-wrap').style.opacity = '1';
			animateCells(true);
		}
	});

	// Calculate how many weeks fit the container
	const containerWidth = chart.parentElement.offsetWidth || 500;
	const cellSize = 10; // 8px + 2px gap
	const WEEKS = Math.floor(containerWidth / cellSize);

	fetch('https://github-contributions-api.jogruber.de/v4/xzebra?y=last')
		.then(r => r.json())
		.then(data => {
			const contributions = data.contributions;
			const today = new Date();
			const startDate = new Date(today);
			startDate.setDate(startDate.getDate() - (WEEKS * 7));

			const weeks = [];
			let currentWeek = [];

			contributions.forEach(day => {
				const d = new Date(day.date);
				if (d < startDate) return;
				if (d.getDay() === 0 && currentWeek.length > 0) {
					weeks.push(currentWeek);
					currentWeek = [];
				}
				currentWeek.push(day);
			});
			if (currentWeek.length > 0) weeks.push(currentWeek);

			buildChart(weeks.slice(-WEEKS));
		})
		.catch(() => {
			const weeks = [];
			for (let w = 0; w < WEEKS; w++) {
				const week = [];
				for (let d = 0; d < 7; d++) {
					week.push({ level: 0 });
				}
				weeks.push(week);
			}
			buildChart(weeks);
		});
</script>

<style is:inline>
	.page {
		max-width: 550px;
		margin: 0 auto;
		padding: 5rem 1.5rem 4rem;
	}

	header h1 {
		font-size: 0.875rem;
		font-weight: 400;
		color: #111;
		margin: 0;
		line-height: 1.2;
	}

	header .tagline {
		font-size: 0.875rem;
		color: #999;
		display: flex;
		align-items: center;
		gap: 2px;
		margin-top: 0.05rem;
	}

	.loc-icon {
		width: 13px;
		height: 13px;
	}

	.dot {
		margin: 0 5px;
	}

	.bio {
		margin-top: 2rem;
	}

	.bio p {
		font-size: 0.875rem;
		line-height: 1.75;
		color: #000;
		font-weight: 450;
		margin-bottom: 1.25rem;
	}

	.bio p:last-child {
		margin-bottom: 0;
	}

	.bio a {
		color: #111;
		text-decoration: none;
		font-weight: 550;
		transition: font-weight 0.15s ease;
	}

	.bio a:hover {
		font-weight: 700;
	}

	.whop-link {
		text-decoration: none !important;
	}

	.inline-icon {
		width: 14px;
		height: 14px;
		border-radius: 3px;
		vertical-align: -2px;
		background: #e5e7eb;
	}

	/* App icon stack */
	.socials-line {
		display: inline;
	}

	.app-icons {
		display: inline-flex;
		align-items: center;
		vertical-align: -4px;
		margin-left: 2px;
	}

	.app-icon {
		display: block;
		width: 18px;
		height: 18px;
		min-width: 18px;
		min-height: 18px;
		border-radius: 4px;
		overflow: hidden;
		position: relative;
		box-shadow: 0 0 0 1.5px #fafafa;
		text-decoration: none !important;
		line-height: 0;
		will-change: transform;
	}

	.app-icon svg {
		display: block;
		width: 18px;
		height: 18px;
	}

	.app-icons {
		filter: grayscale(100%);
		transition: filter 0.3s ease;
	}

	.app-icons:hover,
	.app-icons.touched {
		filter: grayscale(0%);
	}



	.projects {
		margin-top: 3rem;
	}

	.projects h2 {
		font-size: 0.875rem;
		font-weight: 400;
		color: #999;
		margin: 0 0 0.75rem 0;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid #eee;
	}

	.projects ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.projects li {
		display: flex;
		align-items: center;
		padding: 0.45rem 0;
		cursor: pointer;
	}

	.projects li a {
		font-size: 0.875rem;
		color: #111;
		text-decoration: none;
		white-space: nowrap;
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		width: 130px;
	}

	.projects li a {
		transition: font-weight 0.15s ease;
	}

	.projects li:hover a {
		font-weight: 700;
	}

	.project-icon {
		width: 18px;
		height: 18px;
		border-radius: 4px;
		background: #e5e7eb;
	}

	.projects .desc {
		font-size: 0.875rem;
		color: #999;
	}

	.teaser {
		cursor: default !important;
		flex-direction: column;
		align-items: flex-start !important;
		margin-top: 0.5rem;
	}

	.teaser-text {
		font-size: 0.875rem;
		color: #999;
		font-style: italic;
	}

	.ghchart-wrap {
		width: 100%;
		max-height: 0;
		opacity: 0;
		overflow: hidden;
		transition:
			max-height 0.5s ease,
			opacity 0.3s ease;
	}


	.ghchart {
		display: flex;
		gap: 2px;
		margin-top: 6px;
		width: 100%;
	}

	.ghchart-col {
		display: flex;
		flex-direction: column;
		gap: 2px;
		flex: 1;
	}

	.ghchart-cell {
		width: 100%;
		aspect-ratio: 1;
		border-radius: 2px;
		background: #ebedf0;
		transition: filter 0.25s ease;
	}


	[data-anim] {
		opacity: 0;
		transform: translateY(12px);
		transition: opacity 0.5s ease, transform 0.5s ease;
	}

	[data-anim].visible {
		opacity: 1;
		transform: translateY(0);
	}
</style>

<script>
	document.querySelectorAll('[data-anim]').forEach((el, i) => {
		setTimeout(() => el.classList.add('visible'), i * 60);
	});
</script>
