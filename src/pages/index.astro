---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Jorge Romanos" description="Software developer">
	<main class="page">
		<header>
			<h1>Jorge Romanos</h1>
			<span class="alias">zebra</span>
		</header>

		<div class="bio">
			<p>
				Software Engineer with a special interest in the Apple ecosystem. Cybersecurity enthusiast. Currently working at <a href="https://whop.com">Whop</a> as an iOS Engineer.
			</p>

			<p>
				I started learning to code at a young age by modding videogames, then took it more seriously with competitive programming and made it to the national final. I studied Software Engineering at the <a href="https://eina.unizar.es/en/welcome">University of Zaragoza</a>. I love automating stuff and in my free time I build apps and tools.
			</p>

			<p>
				You can find me on <a href="https://x.com/zebra_dev">X</a>, <a href="https://instagram.com/zebra_dev">Instagram</a>, <a href="https://github.com/xzebra">GitHub</a>, or reach me via <a href="mailto:contact@xzebra.dev">email</a>.
			</p>
		</div>

		<section class="projects">
			<h2>Projects</h2>
			<ul>
				<li>
					<a href="https://appframes.app">AppFrames</a>
					<span class="desc">Device frame screenshots for the App Store</span>
				</li>
				<li>
					<a href="https://billsharing.app">BillShare</a>
					<span class="desc">Split bills with friends</span>
				</li>
				<li>
					<a href="https://blocko.app">Blocko</a>
					<span class="desc">Block distracting apps</span>
				</li>
				<li>
					<a href="https://visitplaces.app">Places</a>
					<span class="desc">Save and share places you visit</span>
				</li>
				<li>
					<a href="https://timedeposit.app">TimeDeposit</a>
					<span class="desc">Track your time deposits</span>
				</li>
			</ul>
		</section>
	</main>
</SiteLayout>

<style>
	.page {
		max-width: 550px;
		margin: 0 auto;
		padding: 5rem 1.5rem 4rem;
	}

	header h1 {
		font-size: 0.875rem;
		font-weight: 400;
		color: #111;
		margin: 0;
	}

	header .alias {
		font-size: 0.875rem;
		color: #999;
		display: block;
		margin-top: 0.15rem;
	}

	.bio {
		margin-top: 2rem;
	}

	.bio p {
		font-size: 0.875rem;
		line-height: 1.75;
		color: #333;
		margin-bottom: 1.25rem;
	}

	.bio p:last-child {
		margin-bottom: 0;
	}

	.bio a {
		color: #333;
		text-decoration: underline;
		text-decoration-color: #ccc;
		text-underline-offset: 2px;
		transition: text-decoration-color 0.2s;
	}

	.bio a:hover {
		text-decoration-color: #333;
	}

	.projects {
		margin-top: 3rem;
	}

	.projects h2 {
		font-size: 0.875rem;
		font-weight: 400;
		color: #999;
		margin: 0 0 0.75rem 0;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid #eee;
	}

	.projects ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.projects li {
		display: flex;
		align-items: baseline;
		gap: 1.5rem;
		padding: 0.5rem 0;
	}

	.projects li a {
		font-size: 0.875rem;
		color: #111;
		text-decoration: none;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.projects li a:hover {
		text-decoration: underline;
	}

	.projects .desc {
		font-size: 0.875rem;
		color: #999;
	}
</style>
