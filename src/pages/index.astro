			</ul>
		</section>
	</main>
</SiteLayout>

<script>
	const stack = document.querySelector('.app-icons');
	const icons = Array.from(stack.querySelectorAll('.app-icon'));
	const COLLAPSED_OFFSET = -5;
	const EXPANDED_GAP = 4;
	const STIFFNESS = 0.15;
	const DAMPING = 0.7;

	let expanded = false;
	let springs = icons.map((_, i) => ({
		current: i === 0 ? 0 : COLLAPSED_OFFSET,
		target: i === 0 ? 0 : COLLAPSED_OFFSET,
		velocity: 0,
		scale: 1,
		scaleTarget: 1,
		scaleVelocity: 0,
	}));

	let raf = null;

	function animate() {
		let settled = true;
		icons.forEach((icon, i) => {
			const s = springs[i];

			// position spring
			const force = (s.target - s.current) * STIFFNESS;
			s.velocity = (s.velocity + force) * DAMPING;
			s.current += s.velocity;

			// scale spring
			const scaleForce = (s.scaleTarget - s.scale) * STIFFNESS;
			s.scaleVelocity = (s.scaleVelocity + scaleForce) * DAMPING;
			s.scale += s.scaleVelocity;

			if (Math.abs(s.velocity) > 0.01 || Math.abs(s.target - s.current) > 0.01 ||
				Math.abs(s.scaleVelocity) > 0.001 || Math.abs(s.scaleTarget - s.scale) > 0.001) {
				settled = false;
			}

			icon.style.transform = `translateX(${i === 0 ? 0 : s.current * i}px) scale(${s.scale})`;
			icon.style.zIndex = s.scale > 1.05 ? '2' : '';
		});

		if (!settled) {
			raf = requestAnimationFrame(animate);
		} else {
			raf = null;
		}
	}

	function startAnim() {
		if (!raf) raf = requestAnimationFrame(animate);
	}

	stack.addEventListener('mouseenter', () => {
		expanded = true;
		springs.forEach((s, i) => {
			s.target = i === 0 ? 0 : EXPANDED_GAP;
		});
		startAnim();
	});

	stack.addEventListener('mouseleave', () => {
		expanded = false;
		springs.forEach((s, i) => {
			s.target = i === 0 ? 0 : COLLAPSED_OFFSET;
			s.scaleTarget = 1;
		});
		startAnim();
	});

	icons.forEach((icon, i) => {
		icon.addEventListener('mouseenter', () => {
			springs[i].scaleTarget = 1.2;
			startAnim();
		});
		icon.addEventListener('mouseleave', () => {
			springs[i].scaleTarget = 1;
			startAnim();
		});
	});

	// Set initial positions
	icons.forEach((icon, i) => {
		icon.style.transform = `translateX(${i === 0 ? 0 : COLLAPSED_OFFSET * i}px) scale(1)`;
	});
</script>

<style is:inline>
	.page {
		max-width: 550px;
		margin: 0 auto;
		padding: 5rem 1.5rem 4rem;
	}

	header h1 {
		font-size: 0.875rem;
		font-weight: 400;
		color: #111;
		margin: 0;
		line-height: 1.2;
	}

	header .alias {
		color: #999;
		font-weight: 400;
	}

	header .tagline {
		font-size: 0.875rem;
		color: #999;
		display: flex;
		align-items: center;
		gap: 2px;
		margin-top: 0.05rem;
	}

	.loc-icon {
		width: 13px;
		height: 13px;
	}

	.bio {
		margin-top: 2rem;
	}

	.bio p {
		font-size: 0.875rem;
		line-height: 1.75;
		color: #333;
		margin-bottom: 1.25rem;
	}

	.bio p:last-child {
		margin-bottom: 0;
	}

	.bio a {
		color: #333;
		text-decoration: underline;
		text-decoration-color: #ccc;
		text-underline-offset: 2px;
		transition: text-decoration-color 0.2s;
	}

	.bio a:hover {
		text-decoration-color: #333;
	}

	.whop-link {
		text-decoration: none !important;
	}

	.whop-link:hover {
		text-decoration: underline !important;
		text-decoration-color: #333 !important;
	}

	.inline-icon {
		width: 14px;
		height: 14px;
		border-radius: 3px;
		vertical-align: -2px;
	}

	/* App icon stack */
	.socials-line {
		display: inline;
	}

	.app-icons {
		display: inline-flex;
		align-items: center;
		vertical-align: -4px;
		margin-left: 2px;
	}

	.app-icon {
		display: block;
		width: 18px;
		height: 18px;
		min-width: 18px;
		min-height: 18px;
		border-radius: 4px;
		overflow: hidden;
		position: relative;
		box-shadow: 0 0 0 1.5px #fafafa;
		text-decoration: none !important;
		line-height: 0;
		will-change: transform;
	}

	.app-icon svg {
		display: block;
		width: 18px;
		height: 18px;
	}

	.projects {
		margin-top: 3rem;
	}

	.projects h2 {
		font-size: 0.875rem;
		font-weight: 400;
		color: #999;
		margin: 0 0 0.75rem 0;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid #eee;
	}

	.projects ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.projects li {
		display: flex;
		align-items: baseline;
		gap: 1.5rem;
		padding: 0.5rem 0;
	}

	.projects li a {
		font-size: 0.875rem;
		color: #111;
		text-decoration: none;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.projects li a:hover {
		text-decoration: underline;
	}

	.projects .desc {
		font-size: 0.875rem;
		color: #999;
	}
</style>
