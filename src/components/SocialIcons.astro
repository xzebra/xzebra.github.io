---
const links = [
	{ href: 'https://apps.apple.com/my/developer/jorge-romanos/id1661169612', label: 'App Store', glyph: '' },
	{ href: 'https://www.github.com/xzebra', label: 'GitHub', glyph: '' },
	{ href: 'https://x.com/zebra_dev', label: 'Twitter', glyph: '𝕏' },
	{ href: 'https://instagram.com/zebra_dev', label: 'Instagram', glyph: '' },
	{ href: 'mailto:contact@xzebra.dev', label: 'Email', glyph: '✉︎' },
	{ href: 'https://app.codesignal.com/profile/xzebra', label: 'CodeSignal', glyph: '◆' },
	{ href: 'https://www.linkedin.com/in/jorge-romanos', label: 'LinkedIn', glyph: 'in' },
];
---

<ul class="social">
  {links.map(link => (
    <li>
      <a href={link.href} target="_blank" rel="noreferrer" aria-label={link.label}>{link.glyph}</a>
    </li>
  ))}
</ul>

<style is:inline>
.social { list-style: none; display: flex; gap: .75rem; margin-top: 2rem; padding: 0; }
.social a { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border: 1px solid #e5e7eb; border-radius: 8px; color: #111827; text-decoration: none; font-size: 0.9rem; }
.social a:hover { background: #f9fafb; }
</style>

