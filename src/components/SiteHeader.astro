---
const { pathname } = Astro.url;
---

<header class="site-header">
  <div class="container">
    <nav class="nav">
      <a href="/" class={pathname === '/' ? 'active' : ''}>whoami</a>
      <a href="/blog" class={pathname.startsWith('/blog') ? 'active' : ''}>blog</a>
      <a href="/apps" class={pathname.startsWith('/apps') ? 'active' : ''}>apps</a>
    </nav>
  </div>
  </header>

<style is:inline>
  .site-header { padding: 1.5rem 0 0; border-bottom: 0; }
  .container { max-width: 500px; margin: 0 auto; padding: 0 1rem; display: flex; align-items: center; justify-content: flex-start; }
  .nav { display: flex; gap: 1.25rem; }
  .nav a { text-decoration: none; color: #6b7280; padding-bottom: 2px; }
  .nav a.active { color: #111827; border-bottom: 2px solid #111827; }
  .nav a:hover { color: #111827; }
</style>

